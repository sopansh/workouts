---
import Base from '../../layouts/Base.astro';
import PlyometricsSafety from '../../components/PlyometricsSafety.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { loadGuide } from '../../lib/guide';

const data = await loadGuide('plyometrics', { phase: 'base' });
const pages = [
  { href: '/plyometrics/weekly-plan/', title: 'Weekly plan', blurb: 'The week at a glance, the shared warm-up and the two sessions.', accent: 'p3' },
  { href: '/plyometrics/exercises/', title: 'Exercises', blurb: 'Setup, steps, mistakes, who should not do it and a regression for each exercise.', accent: 'p2' },
  { href: '/plyometrics/progression/', title: 'Progression', blurb: 'The eight-week table, foot contacts per session and when to hold back.', accent: 'p1' },
  { href: '/plyometrics/fascia/', title: 'Fascia and tendons', blurb: 'What fascia is, what the calf and hopping work does and does not show, with graded sources.', accent: 'p4' },
];
---
<Base section="plyometrics" title="Plyometrics" description="A basic, repeatable two-session plyometrics plan using the floor, a few cones and an adjustable box, with calf, ankle and tendon basics. Draft, for later use once cleared to jump.">
  <section class="hero page-head">
    <p class="eyebrow">Plyometrics</p>
    <h1>Basic, repeatable jump training</h1>
    <p class="lede">Two short sessions a week built from a few simple jumps, calf work and balance, repeated with small, patient increases. It uses only a clear floor, a couple of cones and an adjustable box. Everything starts on the floor.</p>
    <div class="badges">
      <span class="badge" data-tone="info">2 sessions a week</span>
      <span class="badge">30–40 min</span>
      <span class="badge">8 weeks, repeated</span>
      <StatusBadge status={data.plan.data.status} />
    </div>
  </section>

  <PlyometricsSafety />

  <section aria-labelledby="who">
    <h2 id="who">Who this is for</h2>
    <p class="prose">Written for adults who already train and want basic, repeatable work to build jump power and look after the feet, ankles and calves. Start only if you have no current injury or pain and have been cleared to exercise; speak to a doctor or physiotherapist first if you are unsure. The strength section's beginner-only rule for squats, glutes and the lower back does not apply to jumping: here, everything starts at the beginning.</p>
  </section>

  <section aria-labelledby="pages">
    <h2 id="pages">What is on each page</h2>
    <ul class="grid">
      {pages.map(page => (
        <li>
          <a class="card" data-accent={page.accent} href={page.href}>
            <h3>{page.title}</h3>
            <p>{page.blurb}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="equipment">
    <h2 id="equipment">Equipment and the box</h2>
    <ul class="prose">
      <li><b>Floor.</b> A stable, non-slip surface with clear space overhead. Do not jump on a soft or uneven surface such as a mattress or thick mat. If the floor is slippery or gives under your feet, choose another surface.</li>
      <li><b>Cones.</b> Used as flat markers for the side-to-side hop, about 30 to 40 cm apart. You do not jump over them.</li>
      <li><b>Box.</b> A plyometric box typically offers roughly 50, 60 or 70 cm depending on the face. Those are all high for learning, so the first eight weeks do not use it. See <a href="/plyometrics/progression/#box">when and whether to bring it in</a>.</li>
    </ul>
  </section>

  <section aria-labelledby="strength">
    <h2 id="strength">Fitting it round strength training</h2>
    <p class="prose">Allow at least 48 hours between the two sessions. Do the warm-up first, then the jumps, then any lifting, so the jumps are done fresh. The leg days in the <a href="/strength/weekly-plan/paired-muscle-split/">paired split</a> are the heaviest, so check how recovery feels before combining a jump session with one. This pairing is a suggestion, not tested advice.</p>
  </section>

  <p class="note">The doses in this section are conservative planning conventions, not a validated prescription. Where evidence is cited it is graded on the <a href="/plyometrics/fascia/#evidence">fascia and tendons page</a>.</p>
</Base>
