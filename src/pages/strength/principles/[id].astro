---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ClaimList from '../../../components/ClaimList.astro';
import EvidenceBadge from '../../../components/EvidenceBadge.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import { loadAll, url } from '../../../lib/content';

export async function getStaticPaths() {
  const d = await loadAll();
  return d.principles.map(entry => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = await loadAll();
const { Content } = await render(entry);
const usedIn = d.programs.filter(p => p.data.principles.some(r => r.id === entry.id));
const index = d.principles.findIndex(p => p.id === entry.id);
const prev = d.principles[index - 1];
const next = d.principles[index + 1];
---
<Base title={entry.data.title} description={entry.data.summary} accent="p2">
  <Breadcrumbs items={[{ label: 'Strength', href: url.hub }, { label: 'Principles', href: url.principles }, { label: entry.data.title }]} />
  <section class="hero page-head">
    <p class="eyebrow">Principle</p>
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.summary}</p>
    <div class="badges"><StatusBadge status={entry.data.status} /></div>
  </section>

  {entry.data.rules.length > 0 && (
    <section aria-labelledby="rules">
      <h2 id="rules">Practical rules</h2>
      <ul class="rules">
        {entry.data.rules.map(rule => {
          const claim = rule.claim ? d.claimById.get(rule.claim.id) : undefined;
          return (
            <li>
              <p>{rule.text}</p>
              <div class="badges">
                {claim
                  ? <><EvidenceBadge grade={claim.data.grade} /> <a class="small" href={`#claim-${claim.id}`}>see claim</a></>
                  : <span class="badge" data-grade="D" title="This rule is a plan convention, not backed by a graded claim."><b>Plan convention</b></span>}
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <div class="prose"><Content /></div>

  {entry.data.claims.length > 0 && (
    <section aria-labelledby="claims">
      <h2 id="claims">Evidence</h2>
      <ClaimList claims={entry.data.claims.map(c => c.id)} claimById={d.claimById} sourceById={d.sourceById} />
    </section>
  )}

  {usedIn.length > 0 && (
    <section aria-labelledby="used">
      <h2 id="used">Used in</h2>
      <ul class="chip-list">
        {usedIn.map(p => <li><a class="chip" href={url.program(p.id)}>{p.data.name}</a></li>)}
        <li><a class="chip" href={url.weekly()}>Weekly plan</a></li>
      </ul>
    </section>
  )}

  {entry.data.related.length > 0 && (
    <section aria-labelledby="related">
      <h2 id="related">Related principles</h2>
      <ul class="chip-list">
        {entry.data.related.map(r => <li><a class="chip" href={url.principle(r.id)}>{d.principleById.get(r.id)!.data.title}</a></li>)}
      </ul>
    </section>
  )}

  <nav class="nav-pair" aria-label="Principle pages">
    {prev ? <a href={url.principle(prev.id)}>← {prev.data.title}</a> : <span />}
    {next ? <a href={url.principle(next.id)}>{next.data.title} →</a> : <span />}
  </nav>
</Base>
