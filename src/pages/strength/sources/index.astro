---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SourceList from '../../../components/SourceList.astro';
import { loadAll, url } from '../../../lib/content';

const d = await loadAll();
---
<Base section="strength" title="Sources" description="The source register: every reference used on the site, with its study type and verification date." accent="p1">
  <Breadcrumbs items={[{ label: 'Strength', href: url.hub }, { label: 'Sources' }]} />
  <section class="hero page-head">
    <p class="eyebrow">Sources</p>
    <h1>Source register</h1>
    <p class="lede">{d.sources.length} references. DOIs were checked on Crossref, and claims were written from the abstracts. Open a DOI to read the paper.</p>
  </section>
  <SourceList sources={d.sources} claims={d.claims} evidenceHref={url.evidence} />
</Base>
