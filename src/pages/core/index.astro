---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Callout from '../../components/Callout.astro';
import '../../styles/core.css';

const phases = (await getCollection('corePhases')).sort((a, b) => a.data.number - b.data.number);
const exercises = (await getCollection('coreExercises')).sort((a, b) => a.data.order - b.data.order);
const exercisesIn = (phase: number) => exercises.filter(e => e.data.phase === phase);
const sentence = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);

// The 3D rig reads each exercise's poses in the browser. `<` is escaped so the JSON can never close its script tag.
const clientData = JSON.stringify(exercises.map(e => ({ id: e.id, ...e.data }))).replace(/</g, '\\u003c');
---
<Base section="isometrics" title="Back-safe core, glute and power guide" description="A three-phase recovery plan after a lower-back strain: stabilise, load, then power, with looping 3D exercise demos." draft={false}>
  <Fragment slot="head">
    <script
      is:inline
      defer
      src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"
      integrity="sha512-dLxUelApnYxpLt6K2iomGngnHO83iUvZytA3YjDUCjT0HDOHKXnVYdf3hU4JjM8uEhxf9nD1/ey98U3t2vZ0qQ=="
      crossorigin="anonymous"
    ></script>
    <noscript><style>.stage__fallback { display: grid; } .stage__canvas, .stage__hint { display: none; }</style></noscript>
  </Fragment>

  <nav slot="nav" class="toolbar__nav" id="phase-nav" aria-label="Sections">
    <a href="#plan" data-target="plan">Plan</a>
    {phases.map(phase => (
      <a href={`#phase-${phase.data.number}`} data-target={`phase-${phase.data.number}`} data-phase={phase.data.number}>
        <span class="pill__num" aria-hidden="true">{phase.data.number}</span>{phase.data.title}
      </a>
    ))}
  </nav>

  <Fragment slot="controls">
    <button id="speed" class="btn" type="button"><span class="btn__label">Speed 1×</span></button>
    <button id="pp" class="btn" type="button" aria-pressed="false">
      <span class="icon" aria-hidden="true">❚❚</span><span class="btn__label">Pause animations</span>
    </button>
  </Fragment>

  <section class="hero">
    <p class="eyebrow">Lower-back recovery plan</p>
    <h1>Back-safe core, glute and power guide</h1>
    <p class="lede">Ten days after a lower-back strain, the order matters: stabilise, load, then power. Each 3D figure loops the movement, and the red glow marks the muscles doing the work. Drag a figure sideways to rotate it and see the movement from the front or back.</p>
    <p class="legend"><span class="dot" aria-hidden="true"></span>Working muscle</p>
  </section>

  <Callout>
    <p><b>Pain rule.</b> Stay at 2/10 or lower during an exercise, and no worse the next morning. Stop and see a doctor for pain below the knee, numbness or tingling, leg weakness, night pain that doesn’t ease, or any bladder or bowel change (urgent). Not improving by 2–3 weeks also means a check-up.</p>
  </Callout>

  <section id="plan" class="plan" aria-labelledby="plan-title">
    <h2 id="plan-title">When to do what</h2>
    <ol class="plan__steps">
      {phases.map(phase => (
        <li class="plan__step" data-phase={phase.data.number}>
          <div class="plan__head">
            <span class="plan__num" aria-hidden="true">{phase.data.number}</span>
            <div>
              <h3 class="plan__title">{phase.data.title}</h3>
              {phase.data.duration && <p class="plan__time">{phase.data.duration}</p>}
            </div>
          </div>
          <dl class="plan__details">
            <dt>Move on when</dt><dd>{phase.data.moveOn}</dd>
            <dt>What you do</dt><dd>{phase.data.plan}</dd>
          </dl>
        </li>
      ))}
    </ol>
  </section>

  {phases.map(phase => {
    const cards = exercisesIn(phase.data.number);
    return (
      <section class="phase" id={`phase-${phase.data.number}`} data-phase={phase.data.number} aria-labelledby={`phase-${phase.data.number}-title`}>
        <header class="phase__head">
          <span class="phase__num" aria-hidden="true">{phase.data.number}</span>
          <div>
            <h2 id={`phase-${phase.data.number}-title`}>Phase {phase.data.number}: {phase.data.title.toLowerCase()}</h2>
            {phase.data.intro && <p class="phase__intro">{phase.data.intro}</p>}
          </div>
        </header>
        <div class="phase__cards">
          {cards.map((exercise, index) => (
            <article class="demo" id={exercise.id}>
              <div class="stage">
                <canvas class="stage__canvas" role="img" tabindex="0" aria-label={`${exercise.data.name}, 3D animation. Drag sideways or use the left and right arrow keys to rotate.`}></canvas>
                <p class="stage__fallback">3D preview unavailable. The instructions still apply.</p>
                <span class="stage__badge">Phase {phase.data.number} · {index + 1}/{cards.length}</span>
                <span class="stage__hint" aria-hidden="true">Drag to rotate</span>
              </div>
              <div class="demo__body">
                <h3 class="demo__title">{exercise.data.name}</h3>
                <div class="demo__facts">
                  <p class="dose"><span class="tag">Dose</span>{exercise.data.dose}</p>
                  <p class="works"><span class="tag">Works</span><span class="mus">{exercise.data.muscles}</span></p>
                  <p class="avoid"><span class="tag">Common mistakes</span>{sentence(exercise.data.mistakes)}</p>
                </div>
                <ol class="steps steps--numbered">{exercise.data.steps.map(step => <li>{step}</li>)}</ol>
              </div>
            </article>
          ))}
        </div>
      </section>
    );
  })}

  <script id="core-data" type="application/json" set:html={clientData} is:inline></script>

  <p slot="footer">Sources behind the approach: McGill’s core stability work (curl-up, side plank, bird dog), Lake and Lauder 2012 on kettlebell swing training and power, and Oranchuk et al. 2019 on isometric training. This guide is general education and does not replace a physiotherapist’s assessment of your back.</p>

  <script>
    import '../../scripts/core/main.js';
  </script>
</Base>
