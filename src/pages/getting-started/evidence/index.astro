---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ClaimList from '../../../components/ClaimList.astro';
import GettingStartedSafety from '../../../components/GettingStartedSafety.astro';
import SourceList from '../../../components/SourceList.astro';
import { loadGuide } from '../../../lib/guide';

const data = await loadGuide('getting-started');
const gaps = [
  'No systematic review of calisthenics or bodyweight training for beginners was found when searching Europe PMC. This plan applies resistance-training evidence to bodyweight ladders, which is an extrapolation.',
  'Most of the push-up trials were in young men. No trial of women doing home bodyweight training for strength was found, so the sex-difference evidence is for resistance training in general.',
  'No source was found that shows these exact ladders, or the move-up rule, outperform others. They are practical conventions.',
  'No evidence was gathered on injury rates for home exercise, so none are stated.',
];
---
<Base section="getting-started" title="Evidence" description="The graded claims and sources behind the getting-started plan, with each claim's limits and the gaps in the evidence.">
  <Breadcrumbs items={[{ label: 'Getting started', href: '/getting-started/' }, { label: 'Evidence' }]} />
  <section class="hero page-head">
    <p class="eyebrow">Evidence</p>
    <h1>What this plan rests on</h1>
    <p class="lede">Each claim has a grade, its limits and its sources. The grades follow the <a href="/strength/evidence/">strength section's rubric</a>. Every journal source had its abstract read and its DOI, title, year and retraction status checked on Crossref. That check shows the paper exists; it does not show that the claim fits perfectly here, so the limits are stated.</p>
  </section>

  <GettingStartedSafety />

  <section aria-labelledby="gaps">
    <h2 id="gaps">What the evidence does not cover</h2>
    <ul class="prose">{gaps.map(gap => <li>{gap}</li>)}</ul>
  </section>

  <section aria-labelledby="claims">
    <h2 id="claims">Claims and grades</h2>
    <ClaimList claims={data.claims.map(claim => claim.id)} claimById={data.claimById} sourceById={data.sourceById} sourcesHref="" />
  </section>

  <section aria-labelledby="sources">
    <h2 id="sources">All sources</h2>
    <SourceList sources={data.sources} claims={data.claims} evidenceHref="/getting-started/evidence/" />
  </section>
</Base>
